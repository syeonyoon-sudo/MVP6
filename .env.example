# ───────────────────────────────────────────────
# 냉장고 한 끼 환경 변수
# - Vercel: Settings → Environment Variables 에 같은 이름으로 입력 후 Redeploy
# - 내 컴퓨터: 이 파일을 복사해 .env.local 을 만들고 값 입력 (.env.local 은 GitHub에 올라가지 않음)
# 실제 값이 들어간 파일은 절대 GitHub에 올리지 마세요.
# ───────────────────────────────────────────────

# (선택) 기본은 로그인 없이 브라우저에 저장. 회원가입·로그인을 쓰려면 아래 두 값과 VITE_ENABLE_LOGIN=true 를 함께 입력
# VITE_ENABLE_LOGIN=true
# 회원가입·로그인·데이터 저장 — Supabase → Project Settings → API
VITE_SUPABASE_URL=
# anon public(또는 publishable) 키. 브라우저에 공개돼도 되는 키예요. service_role/secret 키는 절대 넣지 마세요.
VITE_SUPABASE_ANON_KEY=

# (선택) 인증 메일(가입 확인·비밀번호 재설정) 링크가 돌아올 배포 주소. 끝에 / 없이
# 비우면 코드에 적힌 기본 배포 주소를 사용. 개발 환경에서는 무시되고 localhost를 사용
VITE_SITE_URL=

# [필수] 사진 인식·영수증 OCR·AI 추천·AI 질문 — console.anthropic.com → API Keys
# 서버 함수에서만 읽어요. 이름 앞에 VITE_ 를 붙이면 안 돼요(브라우저에 노출됨).
ANTHROPIC_API_KEY=
# (선택) 모델 이름. 비우면 claude-sonnet-5-5
ANTHROPIC_MODEL=

# (개발자 전용) Supabase 없이 화면 점검: true 로 두면 이 브라우저에만 저장되는 점검용 계정 사용
# 배포(Vercel) 환경 변수에는 넣지 마세요.
# VITE_LOCAL_DEV=true
